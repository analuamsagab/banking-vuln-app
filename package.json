{
  "name": "mbanking-vuln",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server.js",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "server": "node server.js",
    "start": "node server.js",
    "lab:start": "npm run build && node server.js",
    "lab:dev": "npm run dev",
    "lab:reset": "node scripts/lab-reset.mjs",
    "lab:stop": "node scripts/lab-stop.mjs",
    "lab:status": "node scripts/lab-status.mjs",
    "lab:prune": "node scripts/lab-prune.mjs",
    "lab:verify": "node lab/verify.mjs",
    "lab:docker:up": "docker compose -f docker-compose.lab.yml up -d --build",
    "lab:docker:down": "docker compose -f docker-compose.lab.yml down",
    "lab:docker:reset": "docker compose -f docker-compose.lab.yml down -v && docker compose -f docker-compose.lab.yml up -d --build"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.28.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
