# Server
PORT=3001
LAB_HOST=127.0.0.1
LAB_PROFILE=web
NODE_ENV=development

# Data runtime (kosongkan untuk memakai root project)
# DATA_DIR=

# Secrets sengaja lemah untuk lab
JWT_SECRET=labsecret
INTERNAL_API_KEY=internal-lab-key-123
SMTP_PASSWORD=smtp-lab-password

# Lab tuning
LAB_EVIDENCE_RETENTION_DAYS=30
LAB_RACE_DELAY_MS=150

# Frontend (kosongkan untuk same-origin / Vite proxy)
VITE_API_URL=
