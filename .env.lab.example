# Contoh konfigurasi lab (copy ke .env)
# Aplikasi ini sengaja HTTP-only dan memakai secret lemah.

PORT=3001
LAB_HOST=127.0.0.1
LAB_PROFILE=web
NODE_ENV=development

# Pisahkan runtime data dari source code (opsional).
# DATA_DIR=./data

# Secret sengaja lemah dan bocor lewat /api/config.
JWT_SECRET=labsecret
INTERNAL_API_KEY=internal-lab-key-123
SMTP_PASSWORD=smtp-lab-password

# Evidence reset disimpan di lab/evidence dan dipangkas otomatis.
LAB_EVIDENCE_RETENTION_DAYS=30
LAB_RACE_DELAY_MS=150

# Frontend: kosongkan untuk same-origin (Vite proxy saat dev).
VITE_API_URL=

# Untuk mengaktifkan XXE, SSTI, dan command injection:
# LAB_PROFILE=extreme
